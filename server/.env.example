PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/teammatch
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
CLIENT_ORIGIN=http://localhost:5173
GIT_COMMIT=local

# SMTP Email Configuration (Gmail, Outlook, SendGrid, Amazon SES, or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TeamMatch Platform" <noreply@teammatch.edu>

# M6 — Admin account seeding (no public signup path to admin)
ADMIN_EMAIL=admin@teammatch.app
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Platform Admin
