PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/teammatch
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
CLIENT_ORIGIN=http://localhost:5173
GIT_COMMIT=local

# M6 — Admin account seeding (no public signup path to admin)
# Generate ADMIN_PASSWORD_HASH with: node -e "const b=require('bcrypt');b.hash('yourpassword',12).then(console.log)"
ADMIN_EMAIL=admin@teammatch.app
ADMIN_PASSWORD_HASH=
ADMIN_NAME=Platform Admin
