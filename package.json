{
  "name": "teammatch",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Assisted Team Formation Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"cyan,magenta\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "seed": "npm run seed -w server",
    "check:docs": "node scripts/check-docs.js"
  },
  "keywords": [
    "team-formation",
    "matching",
    "clean-architecture",
    "hexagonal-architecture"
  ],
  "author": "dev-barot",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
